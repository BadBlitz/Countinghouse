@page "/transactions/uncategorized"
@inject TransactionService TransactionService
@inject CategoryService CategoryService
@inject AccountService AccountService

<PageTitle>Uncategorized - Countinghouse</PageTitle>

<h1>Uncategorized</h1>

<p class="text-muted">
    Everything still missing a category, across all accounts. Pick one and it saves immediately —
    no Edit/Save round trip. For a payee that's always the same thing, a
    <a href="settings/rules">categorization rule</a> handles it in bulk instead; this page is for
    the ones that genuinely differ per purchase.
</p>

@if (rows is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label mb-0 small">Account</label>
            <select class="form-select form-select-sm" @bind="accountFilter" @bind:after="RefreshAsync">
                <option value="0">All accounts</option>
                @foreach (var account in accounts)
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <span class="text-muted small">
                @total uncategorized in total@(accountFilter != 0 ? $", {rows.Count} shown here" : "")
            </span>
        </div>
    </div>

    @if (rows.Count == 0)
    {
        <div class="alert alert-success py-2">
            Nothing left to categorize@(accountFilter != 0 ? " in this account" : "").
        </div>
    }
    else
    {
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Account</th>
                    <th>Payee</th>
                    <th>Memo</th>
                    <th class="text-end">Amount</th>
                    <th style="width: 16rem;">Category</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in rows)
                {
                    <tr class="@(saved.Contains(txn.Id) ? "table-success" : "")">
                        <td>@txn.PostedDate.ToString("M/d/yyyy")</td>
                        <td><a href="accounts/@txn.AccountId">@txn.Account?.Name</a></td>
                        <td>@txn.Payee</td>
                        <td class="text-muted small">@txn.Memo</td>
                        <td class="text-end @(txn.Amount < 0 ? "text-danger" : "")">@txn.Amount.ToString("C2")</td>
                        <td>
                            <select class="form-select form-select-sm"
                                    value="@(txn.CategoryId?.ToString() ?? "")"
                                    @onchange="e => AssignAsync(txn, e.Value?.ToString())">
                                <option value="">-- pick one --</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.FullName</option>
                                }
                            </select>
                        </td>
                        <td class="text-nowrap small">
                            @if (saved.Contains(txn.Id))
                            {
                                <span class="text-success">&#x2713; saved</span>
                            }
                            @if (SamePayeeCount(txn.Payee) > 1)
                            {
                                <span class="text-muted" title="Other uncategorized rows share this payee">
                                    @SamePayeeCount(txn.Payee) with this payee
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (rows.Count >= Limit)
        {
            <p class="text-muted small">
                Showing the newest @Limit. Categorize some and reload for the rest.
            </p>
        }
    }
}

@code {
    private const int Limit = 500;

    private List<Transaction>? rows;
    private List<Category> categories = [];
    private List<Account> accounts = [];
    private int accountFilter;
    private int total;

    // Rows filed during this visit. They stay on the page rather than vanishing under the cursor,
    // which would make a mis-click both invisible and unrecoverable without a reload.
    private readonly HashSet<int> saved = [];

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetCategoriesAsync();
        accounts = await AccountService.GetAccountsAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        saved.Clear();
        rows = await TransactionService.GetUncategorizedAsync(
            accountFilter == 0 ? null : accountFilter, Limit);
        total = await TransactionService.CountUncategorizedAsync();
    }

    private int SamePayeeCount(string payee) =>
        rows?.Count(t => string.Equals(t.Payee, payee, StringComparison.OrdinalIgnoreCase)) ?? 0;

    private async Task AssignAsync(Transaction txn, string? value)
    {
        var categoryId = int.TryParse(value, out var parsed) ? parsed : (int?)null;
        await TransactionService.SetCategoryAsync(txn.Id, categoryId);

        txn.CategoryId = categoryId;
        if (categoryId is null)
            saved.Remove(txn.Id);
        else
            saved.Add(txn.Id);

        total = await TransactionService.CountUncategorizedAsync();
    }
}
