@page "/accounts/{Id:int}/reconcile"
@inject AccountService AccountService
@inject ReconciliationService ReconciliationService
@inject NavigationManager Navigation

<PageTitle>Reconcile @(account?.Name ?? "Account") - Countinghouse</PageTitle>

@if (account is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex align-items-baseline gap-3 flex-wrap">
        <h1 class="mb-0">Reconcile</h1>
        <a class="h4 mb-0" href="accounts/@Id">@account.Name</a>
        <span class="text-muted">@account.AccountType</span>
    </div>

    @if (!account.SyncsTransactions)
    {
        <div class="alert alert-warning mt-3">
            <strong>@account.Name tracks a balance only.</strong>
            Its balance comes straight from SimpleFIN and its register is deliberately not a
            complete history, so there is nothing here that could reconcile to a statement.
        </div>
    }
    else if (error is not null && worksheet is null)
    {
        <div class="alert alert-danger mt-3">@error</div>
    }

    @if (account.SyncsTransactions)
    {
        @if (worksheet is null)
        {
            @* ---------- Step 1: setup ---------- *@
            @if (account.IsSynced && account.BalanceAsOf is not null)
            {
                <div class="card my-3 border-primary" style="max-width: 42rem;">
                    <div class="card-body">
                        <h5 class="card-title">Reconcile against the synced balance</h5>
                        <p class="text-muted small mb-2">
                            Uses the balance SimpleFIN reports — @account.CurrentBalance.ToString("C2")
                            as of @account.BalanceAsOf.Value.ToString("M/d/yyyy") — instead of a paper
                            statement. If the register already adds up to it, this finishes in one step.
                            If it doesn't, the session opens as usual so you can see which row is missing;
                            nothing is ever adjusted away for you.
                        </p>
                        @if (syncedError is not null)
                        {
                            <div class="alert alert-danger py-1 mb-2">@syncedError</div>
                        }
                        <button class="btn btn-outline-primary" @onclick="ReconcileAgainstSyncedBalanceAsync">
                            Reconcile to @account.CurrentBalance.ToString("C2")
                        </button>
                    </div>
                </div>
            }

            <div class="card my-3" style="max-width: 42rem;">
                <div class="card-body">
                    <h5 class="card-title">Statement details</h5>
                    <p class="text-muted small">
                        Copy the figures off the statement exactly. @SignHint
                    </p>

                    @if (suggestion?.IsFirstSession == true)
                    {
                        <div class="alert alert-info py-2 small">
                            <strong>First reconciliation on this account.</strong>
                            The whole QIF history imported as already-reconciled, so start with the
                            first statement whose period <em>begins</em> on or after
                            @suggestion.StartDate.ToString("M/d/yyyy") — the oldest transaction still
                            unreconciled. Anything earlier is already marked <code>R</code> and won't
                            appear in the list to tick.
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label mb-0 small">Statement start date</label>
                            <input type="date" class="form-control form-control-sm" @bind="setupStart" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label mb-0 small">Statement end date</label>
                            @* StartSessionAsync refuses a future end date; don't offer one either. *@
                            <input type="date" class="form-control form-control-sm" @bind="setupEnd"
                                   max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label mb-0 small">Starting balance</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="setupStartingBalance" />
                            @if (suggestion is not null && setupStartingBalance != suggestion.StartingBalance)
                            {
                                <div class="form-text">
                                    Countinghouse expected @suggestion.StartingBalance.ToString("C2")
                                    (@(suggestion.IsFirstSession ? "everything already reconciled" : "the last statement's ending balance")).
                                </div>
                            }
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label mb-0 small">Ending balance</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="setupEndingBalance" />
                        </div>
                    </div>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger py-1 mt-3 mb-0">@error</div>
                    }

                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="StartAsync">Start Reconciling</button>
                        <a class="btn btn-outline-secondary" href="accounts/@Id">Cancel</a>
                    </div>
                </div>
            </div>

            @if (history.Count > 0)
            {
                <h5>Past statements</h5>
                <table class="table table-sm" style="max-width: 42rem;">
                    <thead>
                        <tr>
                            <th>Statement period</th>
                            <th class="text-end">Ending balance</th>
                            <th>Reconciled on</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var past in history)
                        {
                            <tr>
                                <td>@past.StatementStartDate.ToString("M/d/yyyy") – @past.StatementEndDate.ToString("M/d/yyyy")</td>
                                <td class="text-end">@past.StatementEndingBalance.ToString("C2")</td>
                                <td class="text-muted">@past.CompletedAt?.ToString("M/d/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            @* ---------- Step 2: mark cleared ---------- *@
            var session = worksheet.Session;

            <p class="text-muted mt-2 mb-3">
                Statement @session.StatementStartDate.ToString("M/d/yyyy") – @session.StatementEndDate.ToString("M/d/yyyy").
                Tick everything that appears on it. Rows already marked <code>c</code> — anything
                SimpleFIN reported as posted — start ticked; untick whatever the statement doesn't show.
            </p>

            @if (syncedNotice is not null)
            {
                <div class="alert alert-warning py-2">@syncedNotice</div>
            }

            @if (worksheet.StartingBalanceDrift != 0m)
            {
                <div class="alert alert-warning py-2">
                    <strong>Heads up:</strong> the register's reconciled history adds up to
                    @worksheet.ReconciledThroughBalance.ToString("C2"), but this statement starts at
                    @session.StatementStartingBalance.ToString("C2") — a gap of
                    @worksheet.StartingBalanceDrift.ToString("C2"). If that isn't deliberate, the
                    difference below will never reach zero no matter what you tick, and the cause is
                    an earlier statement rather than this one.
                </div>
            }

            <div class="card mb-3">
                <div class="card-body py-2">
                    <div class="row text-center g-2">
                        <div class="col">
                            <div class="text-muted small">Starting balance</div>
                            <div class="fs-5">@session.StatementStartingBalance.ToString("C2")</div>
                        </div>
                        <div class="col">
                            <div class="text-muted small">Cleared (@worksheet.ClearedCount of @worksheet.Rows.Count)</div>
                            <div class="fs-5">@worksheet.ClearedBalance.ToString("C2")</div>
                        </div>
                        <div class="col">
                            <div class="text-muted small">Statement ending balance</div>
                            <div class="fs-5">@session.StatementEndingBalance.ToString("C2")</div>
                        </div>
                        <div class="col">
                            <div class="text-muted small">Difference</div>
                            <div class="fs-4 fw-bold @(worksheet.IsBalanced ? "text-success" : "text-danger")">
                                @worksheet.Difference.ToString("C2")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger py-1">@error</div>
            }

            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-success" disabled="@(!worksheet.IsBalanced)" @onclick="() => FinishAsync(false)">
                    Finish
                </button>
                @if (!worksheet.IsBalanced)
                {
                    @if (confirmAdjustment)
                    {
                        <button class="btn btn-warning" @onclick="() => FinishAsync(true)">
                            Post @worksheet.Difference.ToString("C2") adjustment and finish
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="() => confirmAdjustment = false">Never mind</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-warning" @onclick="() => confirmAdjustment = true">Finish Anyway…</button>
                    }
                }
                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetAllAsync(true)">Tick all</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetAllAsync(false)">Untick all</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="CancelAsync">Abandon</button>
                </div>
            </div>

            @if (worksheet.Rows.Count == 0)
            {
                <div class="alert alert-info">
                    Nothing left to reconcile in this period — every transaction on or before
                    @session.StatementEndDate.ToString("M/d/yyyy") is already reconciled.
                </div>
            }
            else
            {
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 3rem;"></th>
                            <th style="width: 7.5rem;">Date</th>
                            <th>Payee</th>
                            <th style="width: 4.5rem;">Chk #</th>
                            <th>Category</th>
                            <th>Memo</th>
                            <th class="text-end" style="width: 7rem;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in worksheet.Rows)
                        {
                            var isCleared = txn.ClearedStatus == ClearedStatus.Cleared;
                            <tr class="@(isCleared ? "table-success" : "")">
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@isCleared"
                                           @onchange="e => ToggleAsync(txn.Id, (bool)e.Value!)" />
                                </td>
                                <td>
                                    @txn.PostedDate.ToString("M/d/yyyy")
                                    @if (txn.PostedDate < session.StatementStartDate)
                                    {
                                        <span class="badge text-bg-secondary ms-1" title="Dated before this statement period — still outstanding">old</span>
                                    }
                                </td>
                                <td>@txn.Payee</td>
                                <td>@txn.CheckNumber</td>
                                <td>@txn.Category?.FullName</td>
                                <td class="text-muted">@txn.Memo</td>
                                <td class="text-end @(txn.Amount < 0 ? "text-danger" : "")">@txn.Amount.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Account? account;
    private ReconciliationWorksheet? worksheet;
    private ReconciliationSuggestion? suggestion;
    private List<ReconciliationSession> history = [];
    private string? error;
    private string? syncedError;
    private string? syncedNotice;
    private bool confirmAdjustment;

    private DateOnly setupStart;
    private DateOnly setupEnd;
    private decimal setupStartingBalance;
    private decimal setupEndingBalance;

    // A credit card or mortgage carries a negative balance when money is owed, because amounts use
    // SimpleFIN's convention throughout (positive = money in). The statement won't print the minus
    // sign, so say so before the figure gets typed in the wrong direction.
    private string SignHint => account?.AccountType is AccountType.CreditCard or AccountType.Mortgage
        ? "Balances here are negative when you owe money, so a statement balance of $1,234.56 is entered as -1234.56."
        : "Money in is positive, money out is negative.";

    protected override async Task OnParametersSetAsync()
    {
        account = await AccountService.GetAccountAsync(Id);
        if (account is null || !account.SyncsTransactions)
            return;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        confirmAdjustment = false;
        var open = await ReconciliationService.GetOpenSessionAsync(Id);
        worksheet = open is null ? null : await ReconciliationService.GetWorksheetAsync(open.Id);

        if (worksheet is null)
        {
            syncedNotice = null;
            history = await ReconciliationService.GetHistoryAsync(Id);
            suggestion = await ReconciliationService.GetSuggestionAsync(Id);
            setupStart = suggestion.StartDate;
            setupEnd = suggestion.EndDate;
            setupStartingBalance = suggestion.StartingBalance;
            setupEndingBalance = suggestion.StartingBalance;
        }
    }

    // One click: open the ordinary session against the downloaded balance and finish it if it
    // already balances. When it doesn't, the session is deliberately left open — the user lands in
    // the worksheet below, which is the case worth looking at.
    private async Task ReconcileAgainstSyncedBalanceAsync()
    {
        syncedError = null;
        error = null;
        try
        {
            var result = await ReconciliationService.ReconcileAgainstSyncedBalanceAsync(Id);
            if (result.Finished)
            {
                Navigation.NavigateTo($"accounts/{Id}");
                return;
            }

            await RefreshAsync();
            syncedNotice = $"The register doesn't add up to the synced balance of "
                + $"{result.Session.StatementEndingBalance:C2} — it's off by {result.Difference:C2}. "
                + "Tick or untick rows to find the discrepancy, or abandon this session; nothing has "
                + "been reconciled.";
        }
        catch (InvalidOperationException ex)
        {
            syncedError = ex.Message;
        }
    }

    private async Task StartAsync()
    {
        error = null;
        try
        {
            await ReconciliationService.StartSessionAsync(
                Id, setupStart, setupEnd, setupStartingBalance, setupEndingBalance);
            await RefreshAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    private async Task ToggleAsync(int transactionId, bool cleared)
    {
        await ReconciliationService.SetClearedAsync(transactionId, cleared);
        await RefreshAsync();
    }

    private async Task SetAllAsync(bool cleared)
    {
        if (worksheet is null)
            return;
        await ReconciliationService.SetAllClearedAsync(worksheet.Session.Id, cleared);
        await RefreshAsync();
    }

    private async Task FinishAsync(bool postAdjustment)
    {
        if (worksheet is null)
            return;
        error = null;
        try
        {
            await ReconciliationService.FinishAsync(worksheet.Session.Id, postAdjustment);
            Navigation.NavigateTo($"accounts/{Id}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
            await RefreshAsync();
        }
    }

    private async Task CancelAsync()
    {
        if (worksheet is null)
            return;
        await ReconciliationService.CancelSessionAsync(worksheet.Session.Id);
        await RefreshAsync();
    }
}
