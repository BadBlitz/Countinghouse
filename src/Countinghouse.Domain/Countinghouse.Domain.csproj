<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Moved here from the old Web project, and now referenced in code rather than only by the
         tooling: DesignTimeDbContextFactory implements IDesignTimeDbContextFactory, so this needs
         its compile assets. PrivateAssets keeps it from flowing to anything referencing Domain. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- QifParser's date/amount/category-field helpers are internal but worth testing directly:
       the padded-date and tagged-category quirks are where a parser bug is most likely. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Countinghouse.Tests" />
  </ItemGroup>

</Project>
